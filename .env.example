# Google Sheets Configuration (OAuth2)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
SPREADSHEET_ID=your-spreadsheet-id-here
SHEET_RANGE=Attendance!A2:D

# Procare Configuration
PROCARE_EMAIL=your-email@example.com
PROCARE_PASSWORD=your-password
PROCARE_LOGIN_URL=https://schools.procareconnect.com/login
PROCARE_ATTENDANCE_URL=https://schools.procareconnect.com/attendance
PROCARE_TO_ROOM=Room Name
PROCARE_SIGNED_IN_BY=Staff Name

# Scheduler Configuration (for hourly automation)
START_HOUR=7
END_HOUR=18
INTERVAL_MINUTES=60

# Optional: Set to true for testing without actual Procare updates
DRY_RUN=false
