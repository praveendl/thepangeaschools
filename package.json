{
  "name": "procare-attendance-sync",
  "version": "1.0.0",
  "description": "Reads attendance data from a Google Sheet and enters it into Procare via Playwright browser automation.",
  "main": "sync-attendance.js",
  "type": "commonjs",
  "scripts": {
